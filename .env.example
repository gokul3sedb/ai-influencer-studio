# ── Provider keys (server-side only — never exposed to the browser) ──
# kie.ai — https://kie.ai/api-key
KIE_API_KEY=

# WaveSpeed — not yet wired, see lib/providers/wavespeed.js
WAVESPEED_API_KEY=

# ── Access gate ──────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without it /api/generate is an open tap on the
# billing account above. Generate any long random string; the client sends it
# as the x-app-token header. Replace with real per-user auth before launch.
APP_ACCESS_TOKEN=

# Permanent storage for generated media.
# Vercel dashboard -> Storage -> Create a Blob store. Vercel sets this
# automatically once the store is linked to the project.
# Without it the app still works, but every generated image and video
# becomes a dead link after 24 hours.
BLOB_READ_WRITE_TOKEN=
